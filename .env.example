# Copy to .env and fill in. See ARCHITECTURE.md §7 for the credential model and §9 for the
# local vs. cloud story behind DATABASE_URL / TENANT_DATA_DIR.

# --- Control plane ---
# Matches docker-compose.yml's postgres service. Swap for a managed Postgres URL in cloud
# deployment -- this is the only line that needs to change to do that (ARCHITECTURE.md §9).
DATABASE_URL=postgresql+psycopg2://campus_ai:campus_ai@localhost:5432/campus_ai

# --- Content plane (local-disk implementation; see app/storage.py) ---
# Absolute or repo-relative path. Defaults to <repo_root>/data/tenants if unset.
# TENANT_DATA_DIR=./data/tenants

# --- Auth ---
# Operator-only credential (ARCHITECTURE.md §7). Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER commit the real value, never ship it to a browser.
ADMIN_API_KEY=

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Generation (OpenRouter) ---
# Renamed from v1's CAMPUS_AI_API_KEY for clarity (this key is specifically for the generation
# LLM call, not a general "the app's API key" -- see MIGRATION.md).
OPENROUTER_API_KEY=
GENERATION_MODEL=deepseek/deepseek-v4-flash-0731

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-m3
RETRIEVAL_K=4

# --- Rate limiting ---
CHAT_RATE_LIMIT_PER_MINUTE=30
