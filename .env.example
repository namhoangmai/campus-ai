# Copy to .env and fill in. See ARCHITECTURE.md §7 for the credential model and §9 for the
# local vs. cloud story behind DATABASE_URL / TENANT_DATA_DIR.

# --- Deployment ---
# Leave unset ("development") for local dev. Set to "production" in any real deployment
# (single instance, e.g. via backend/Dockerfile) to enable a startup check that refuses to
# boot with an empty ADMIN_API_KEY/OPENROUTER_API_KEY or a DATABASE_URL still pointing at the
# local docker-compose default -- see app/config.py:validate_production_settings.
# ENVIRONMENT=production

# --- Control plane ---
# Matches docker-compose.yml's postgres service. Swap for a managed Postgres URL in cloud
# deployment -- this is the only line that needs to change to do that (ARCHITECTURE.md §9).
DATABASE_URL=postgresql+psycopg2://campus_ai:campus_ai@localhost:5432/campus_ai

# --- Content plane: raw files (local-disk by default; see app/storage.py) ---
# Absolute or repo-relative path. Defaults to <repo_root>/data/tenants if unset. Always used for
# the per-tenant vector store; used for raw documents too unless S3_BUCKET is set below.
# TENANT_DATA_DIR=./data/tenants

# --- Content plane: object storage (Tier 2 cloud swap; see app/storage.py) ---
# Leave S3_BUCKET unset for local dev/tests -- LocalDiskStorage (above) stays active and none of
# these need a value. Set S3_BUCKET to switch raw-document storage to S3-compatible object
# storage. Defaults target Cloudflare R2 (S3 API-compatible); point S3_ENDPOINT_URL at a
# different provider to use that instead. NEVER commit real S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY
# values. NOTE: turning this on does NOT migrate documents already sitting under
# data/tenants/**/raw/ -- that's a separate, explicit migration step.
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# --- Auth ---
# Operator-only credential (ARCHITECTURE.md §7). Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER commit the real value, never ship it to a browser.
ADMIN_API_KEY=

# --- CORS ---
# Comma-separated list of origins allowed to call the API. The localhost defaults below are for
# local dev only -- in production this MUST also include the real deployed frontend origin(s)
# (e.g. https://widget.your-domain.com), or the browser will block every request from it.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Generation (OpenRouter) ---
# Renamed from v1's CAMPUS_AI_API_KEY for clarity (this key is specifically for the generation
# LLM call, not a general "the app's API key" -- see MIGRATION.md).
OPENROUTER_API_KEY=
GENERATION_MODEL=deepseek/deepseek-v4-flash-0731

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-m3
RETRIEVAL_K=4

# --- Rate limiting ---
CHAT_RATE_LIMIT_PER_MINUTE=30

# --- Redis (Tier 2 cloud swap: shared rate limiting + background-job ingestion) ---
# Leave unset for local dev/tests -- the in-memory rate limiter and synchronous ingestion stay
# active, no Redis server needed. Set REDIS_URL to switch both to their Redis/RQ-backed
# implementations; if you do, also deploy backend/scripts/worker.py (backend/Dockerfile.worker)
# as its own process pointed at this same Redis, or uploads will sit in "processing" forever.
# REDIS_URL=redis://localhost:6379/0
